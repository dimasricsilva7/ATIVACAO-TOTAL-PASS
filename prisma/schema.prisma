// Quiz de captação TotalPass + painel de conversão.
// Postgres (Neon). URL pooled para a app; URL direta para migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────── Captação ───────────────────────────

enum LeadStatus {
  NOVO
  CONVERSA_INICIADA
  EM_ATENDIMENTO
  ATIVADO
  NAO_CONVERTIDO
}

model Lead {
  id        String     @id @default(cuid())
  sessionId String?    @unique // liga o lead aos eventos da mesma sessão
  nome      String
  telefone  String // normalizado, só dígitos (com DDD)
  email     String
  objetivo          String?
  acessoAtual       String? @map("acesso_atual")
  preferenciaTreino String? @map("preferencia_treino")
  cidade            String?
  estado            String?
  respostaTaxa      String? @map("resposta_taxa")

  origem        String? // "quiz"
  utmSource     String? @map("utm_source")
  utmMedium     String? @map("utm_medium")
  utmCampaign   String? @map("utm_campaign")
  utmContent    String? @map("utm_content")
  utmTerm       String? @map("utm_term")
  fbclid        String?

  marketingConsent Boolean @default(false) @map("marketing_consent")

  status          LeadStatus @default(NOVO)
  valorRecebido   Int?       @map("valor_recebido") // centavos, preenchido na ativação
  confirmadoEm    DateTime?  @map("confirmado_em")
  obsAdmin        String?    @map("obs_admin")

  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("data_criacao")
  updatedAt DateTime @updatedAt @map("data_atualizacao")

  @@index([status])
  @@index([createdAt])
  @@index([utmCampaign])
  @@map("leads")
}

// ─────────────────────────── Eventos do funil ───────────────────────────

enum QuizEventType {
  quiz_started
  fee_step_reached
  lead_submitted
  whatsapp_clicked
}

model QuizEvent {
  id        String        @id @default(cuid())
  sessionId String        @map("session_id") // aleatório, sem dado pessoal
  type      QuizEventType
  utmSource   String? @map("utm_source")
  utmCampaign String? @map("utm_campaign")
  createdAt DateTime @default(now()) @map("created_at")

  // Deduplicação: uma sessão conta cada evento uma única vez (recarregar a página não duplica).
  @@unique([sessionId, type])
  @@index([type, createdAt])
  @@index([utmCampaign])
  @@map("quiz_events")
}

// ─────────────────────────── Gasto de anúncios (CPL/CPA) ───────────────────────────

model AdSpend {
  id         String   @id @default(cuid())
  data       DateTime // dia do gasto
  campanha   String?
  valorCents Int      @map("valor_cents")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([data])
  @@map("ad_spend")
}

// ─────────────────────────── Configurações (singleton) ───────────────────────────

model Settings {
  id                 String   @id @default("app")
  // CTA final do quiz: "whatsapp" (fala com a equipe) ou "checkout" (vai direto pagar)
  ctaMode            String   @default("whatsapp")
  // Nome que aparece na cobrança (descritor da adquirente). Alterável aqui se mudar de adquirente.
  merchantDescriptor String   @default("BRASIL PAY SERVIÇOS LTDA")
  productName        String   @default("Ativação TotalPass")
  productDescription String   @default("Inclusão de 1 CPF no programa de benefícios TotalPass, com ativação e acompanhamento da nossa equipe.")
  priceCents         Int      @default(24990)
  checkoutHeadline   String   @default("Ative seu acesso ao TotalPass")
  checkoutSubheadline String  @default("Pagamento único e seguro via Pix. Ativação da sua inclusão no programa.")
  updatedAt          DateTime @updatedAt

  @@map("settings")
}

// ─────────────────────────── Pedidos (checkout) ───────────────────────────

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
}

model Order {
  id        String      @id @default(cuid())
  numero    String      @unique // número curto para o cliente/admin
  sessionId String?     @map("session_id")
  leadId    String?     @map("lead_id")
  nome      String
  cpf       String
  email     String
  telefone  String
  amountCents Int       @map("amount_cents")
  merchantDescriptor String @map("merchant_descriptor")
  status    OrderStatus @default(PENDING)

  txId         String?   @map("tx_id") // id da transação na adquirente
  pixCopyPaste String?   @map("pix_copy_paste")
  pixExpiresAt DateTime? @map("pix_expires_at")

  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")
  fbclid      String?

  ipHash    String?   @map("ip_hash")
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([utmCampaign])
  @@map("orders")
}

// ─────────────────────────── Admin ───────────────────────────

enum AdminRole {
  EDITOR
  ADMIN
  OWNER
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  role         AdminRole      @default(ADMIN)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?      @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String    @map("admin_id")
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  ipHash    String?   @map("ip_hash")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([adminId])
  @@map("admin_sessions")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // "email:x" ou "ip:x"
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("login_attempts")
}
