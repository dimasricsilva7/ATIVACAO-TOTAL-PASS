# ─────────────────────────────────────────────────────────────
# ATIVAÇÃO TOTAL PASS — quiz de captação + painel de conversão
# Copie para .env (local) e cadastre na Vercel (Settings → Environment Variables).
# NUNCA commite valores reais. Gere segredos NOVOS.
# ─────────────────────────────────────────────────────────────

# Banco (PostgreSQL / Neon). Pooled para a app, direta para migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# URL pública (sem barra final)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Segredo para hashes/sessões/IP (gere com: openssl rand -hex 32)
AUTH_SECRET=

# Primeiro administrador (bootstrap): npm run admin:hash -- "senha-forte-12+"  → cole a saída (b64:...)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# WhatsApp comercial em formato internacional, só dígitos (ex.: 5511999999999).
# WHATSAPP_PHONE fica só no servidor; o quiz recebe o link pronto da API.
WHATSAPP_PHONE=
# Alternativa: expor no navegador (não é necessário com a implementação atual).
# NEXT_PUBLIC_WHATSAPP_PHONE=

# Taxa de ativação padrão, em centavos (também editável no painel admin). 24990 = R$ 249,90.
INTERMEDIATION_FEE_CENTS=24990

# ── Checkout (PIX) — adquirente. Sem a chave, o checkout informa indisponível (não cobra falso).
BRAVOPAY_API_KEY=
BRAVOPAY_WEBHOOK_SECRET=  # cadastre /api/webhooks/bravopay no painel da adquirente e cole o segredo
BRAVOPAY_PRODUCT_ID=      # opcional
BRAVOPAY_BASE_URL=        # opcional (padrão https://bravopay.club/api/v1)
BRAVOPAY_MODE=            # "mock" = PIX fictício para testar o fluxo (bloqueado em produção)

# Meta Pixel (opcional) — a aplicação funciona normalmente sem ele.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 (opcional)
NEXT_PUBLIC_GA_ID=
